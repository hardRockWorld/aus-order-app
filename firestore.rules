rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper: require authenticated user
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Helper: check admins collection for a document matching the current uid.
     * This assumes you manage admin entries in "admins/{uid}" documents (e.g. created via
     * the Firebase console or a trusted server process). Using custom claims is an
     * alternative; adapt accordingly if you use them.
     */
    function isAdmin() {
      // Admin only if there is an admin marker document at admins/{uid}
      // with a field isAdmin set to true.
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    /**
     * Products collection:
     * - Reads: allowed (public) so product lists and order UIs can load without special rights.
     *   If you prefer to restrict reads to authenticated users, change `if true` to `isSignedIn()`.
     * - Writes (create/update/delete): only admins may perform these operations.
     */
    match /products/{productId} {
      // Allow reads for everyone so the app can load products without special rights
      // Use `read` to cover both `get` and `list` (query).
      // Change to `isSignedIn()` if you want to restrict to authenticated users only.
      // allow get, list: isSignedIn();
      allow read: if isSignedIn();
      // Writes restricted to admins
      allow create, update, delete: if isAdmin();
    }

    /**
     * Orders collection:
     * - Reads and aggregation (for getCountFromServer): allowed for authenticated users.
     * - Creates and updates: allowed for authenticated users.
     * - Deletes: restricted to admins only.
     */
    match /orders/{orderId} {
      // allow standard reads (get, list/query)
      allow get, list: if isSignedIn();
      // allow count/aggregation queries used by the app
      allow aggregate: if isSignedIn();
      // allow creating and updating orders for signed-in users
      allow create, update: if isSignedIn();
      // only admins may delete orders
      allow delete: if isAdmin();
    }

    /**
     * Price changes audit log:
     * - Reads: allowed for authenticated users so the UI can display history.
     *   If you want the history visible only to admins, change to `if isAdmin()`.
     * - Creates/updates/deletes: only admins may write audit entries.
     *
     * Additional validation on create ensures the document contains expected fields and
     * that the `changedBy.uid` matches the authenticated user creating the record.
     * We also check that numeric fields are numbers and `createdAt` is a timestamp.
     */
    match /price_changes/{changeId} {
      // Allow standard reads (get, list/query) for authenticated users
      // Use explicit `aggregate` rule for count queries.
      allow read: if isSignedIn();
      allow aggregate: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.productId is string
        && (request.resource.data.newPrice is number)
        && (request.resource.data.oldPrice is number || request.resource.data.oldPrice == null)
        && request.resource.data.changedBy is map
        && request.resource.data.changedBy.uid == request.auth.uid
        && (request.resource.data.createdAt is timestamp);

      // Only admins can change or remove audit entries
      allow update, delete: if isAdmin();
    }

    /**
     * Admins collection:
     * - Reading admin documents is restricted to admins only.
     * - Only admins can create/update/delete admin entries.
     *
     * Note: Bootstrapping the first admin must be done from a trusted context
     * (Firebase console, admin SDK, or a secure Cloud Function).
     */
    match /admins/{userId} {
      // Allow a signed-in user to read their own admin marker so the client can detect admin status.
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Listing all admins is restricted to admins only
      allow list: if isAdmin();
      // Only admins can manage admin documents
      allow create, update, delete: if isAdmin();
    }

    /**
     * Fallback: deny everything else by default.
     * Add explicit rules for other collections used by your application (orders, customers, etc.)
     * following the principle of least privilege.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
